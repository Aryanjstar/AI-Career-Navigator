<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>AI Career Navigator</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='90'>🚀</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
        

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body { 
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 25%, #334155 50%, #475569 75%, #64748b 100%);
            min-height: 100vh;
        }
        
        .glass-card {
            background: rgba(59, 130, 246, 0.08);
            border: 1px solid rgba(59, 130, 246, 0.2);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 
                       inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .glass-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .glass-hover:hover {
            background: rgba(59, 130, 246, 0.15);
            border: 1px solid rgba(59, 130, 246, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 
                       inset 0 1px 0 rgba(255, 255, 255, 0.15);
        }
        
        .floating-rocket {
            animation: float 6s ease-in-out infinite, pulse 2s ease-in-out infinite alternate;
            display: inline-block;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            25% { transform: translateY(-20px) rotate(2deg); }
            50% { transform: translateY(-15px) rotate(0deg); }
            75% { transform: translateY(-25px) rotate(-2deg); }
        }
        
        @keyframes pulse {
            0% { transform: scale(1); }
            100% { transform: scale(1.1); }
        }
        
        .gradient-text {
            background: linear-gradient(135deg, #60a5fa, #8b5cf6, #a855f7, #3b82f6);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: gradientShift 4s ease-in-out infinite;
        }
        
        @keyframes gradientShift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        .pulse-glow {
            animation: pulse-glow 2s ease-in-out infinite alternate;
        }
        
        @keyframes pulse-glow {
            from { box-shadow: 0 0 20px rgba(139, 92, 246, 0.3); }
            to { box-shadow: 0 0 40px rgba(139, 92, 246, 0.6); }
        }
        
        .feature-icon {
            transition: all 0.3s ease;
        }
        
        .feature-card:hover .feature-icon {
            transform: scale(1.2) rotate(10deg);
        }
        
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
        }
        
        .chat-container {
            max-height: 400px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(59, 130, 246, 0.3) transparent;
        }
        
        .chat-container::-webkit-scrollbar {
            width: 6px;
        }
        
        .chat-container::-webkit-scrollbar-track {
            background: rgba(59, 130, 246, 0.1);
            border-radius: 3px;
        }
        
        .chat-container::-webkit-scrollbar-thumb {
            background: rgba(59, 130, 246, 0.4);
            border-radius: 3px;
        }
        
        .chat-container::-webkit-scrollbar-thumb:hover {
            background: rgba(59, 130, 246, 0.6);
        }
        
        .typing-indicator {
            display: flex;
            align-items: center;
            padding: 15px;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 15px;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        
        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #3b82f6;
            animation: typing 1.4s infinite ease-in-out;
            margin: 0 2px;
        }
        
        .dot:nth-child(1) { animation-delay: -0.32s; }
        .dot:nth-child(2) { animation-delay: -0.16s; }
        
        @keyframes typing {
            0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
            40% { transform: scale(1); opacity: 1; }
        }
        

        
        .active-tab {
            background: rgba(59, 130, 246, 0.3) !important;
            border: 1px solid rgba(59, 130, 246, 0.6) !important;
            box-shadow: 0 0 30px rgba(59, 130, 246, 0.4), 
                       inset 0 0 20px rgba(59, 130, 246, 0.1) !important;
            transform: scale(1.05);
        }
        
        .loading-spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-top: 2px solid #3b82f6;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        /* ============================================
           COMPREHENSIVE RESPONSIVE MEDIA QUERIES
           Mobile First Approach - Industry Standard
           ============================================ */
        
        /* Extra Small Devices (Phones, 320px - 480px) */
        @media (max-width: 480px) {
            body {
                font-size: 14px;
                line-height: 1.5;
            }
            
            /* Navigation */
            nav {
                padding: 0.75rem 1rem !important;
                margin: 0.5rem !important;
            }
            
            nav .flex {
                flex-direction: column;
                gap: 0.5rem;
            }
            
            /* Hero Section */
            .floating-rocket {
                font-size: 3rem !important;
                margin: 1rem 0 !important;
            }
            
            h1.gradient-text {
                font-size: 1.75rem !important;
                line-height: 1.2 !important;
                margin: 0.5rem 0 !important;
            }
            
            h2 {
                font-size: 1.5rem !important;
            }
            
            h3 {
                font-size: 1.25rem !important;
            }
            
            /* Cards and Containers */
            .glass-card {
                margin: 0.5rem !important;
                padding: 1rem !important;
                border-radius: 12px !important;
            }
            
            /* Buttons */
            button, .nav-button {
                padding: 0.75rem 1rem !important;
                font-size: 0.875rem !important;
                min-height: 44px !important; /* iOS touch target */
                width: 100% !important;
                margin: 0.25rem 0 !important;
            }
            
            /* Grid Layouts */
            .bento-grid,
            .grid {
                grid-template-columns: 1fr !important;
                gap: 1rem !important;
            }
            
            /* Forms */
            input, textarea, select {
                font-size: 16px !important; /* Prevents zoom on iOS */
                padding: 0.75rem !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }
            
            /* Chat Container */
            .chat-container {
                max-height: 250px !important;
                padding: 0.75rem !important;
            }
            
            /* Footer */
            footer {
                padding: 1.5rem 1rem !important;
                margin: 0 !important;
            }
            
            footer .grid {
                grid-template-columns: 1fr !important;
                gap: 1.5rem !important;
            }
            
            /* Text */
            p {
                font-size: 0.875rem !important;
                line-height: 1.6 !important;
            }
            
            /* Spacing */
            .container {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
            
            /* Hide less important elements on mobile */
            .hidden-mobile {
                display: none !important;
            }
        }
        
        /* Small Devices (Large Phones, 481px - 640px) */
        @media (min-width: 481px) and (max-width: 640px) {
            body {
                font-size: 15px;
            }
            
            .floating-rocket {
                font-size: 4rem !important;
            }
            
            h1.gradient-text {
                font-size: 2rem !important;
            }
            
            .glass-card {
                margin: 0.75rem !important;
                padding: 1.25rem !important;
            }
            
            button, .nav-button {
                padding: 0.875rem 1.25rem !important;
                font-size: 0.9rem !important;
            }
            
            .bento-grid {
                grid-template-columns: 1fr !important;
                gap: 1.25rem !important;
            }
            
            .chat-container {
                max-height: 300px !important;
            }
            
            .container {
                padding-left: 1.25rem !important;
                padding-right: 1.25rem !important;
            }
        }
        
        /* Medium Devices (Tablets, 641px - 768px) */
        @media (min-width: 641px) and (max-width: 768px) {
            body {
                font-size: 16px;
            }
            
            .floating-rocket {
                font-size: 5rem !important;
            }
            
            h1.gradient-text {
                font-size: 2.5rem !important;
            }
            
            .glass-card {
                margin: 1rem !important;
                padding: 1.5rem !important;
            }
            
            .bento-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 1.5rem !important;
            }
            
            button, .nav-button {
                padding: 1rem 1.5rem !important;
                font-size: 1rem !important;
            }
            
            .chat-container {
                max-height: 350px !important;
            }
            
            footer .grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
            
            .container {
                padding-left: 1.5rem !important;
                padding-right: 1.5rem !important;
            }
        }
        
        /* Large Devices (Small Laptops, 769px - 1024px) */
        @media (min-width: 769px) and (max-width: 1024px) {
            .floating-rocket {
                font-size: 6rem !important;
            }
            
            h1.gradient-text {
                font-size: 3rem !important;
            }
            
            .glass-card {
                margin: 1.25rem !important;
                padding: 2rem !important;
            }
            
            .bento-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 2rem !important;
            }
            
            .chat-container {
                max-height: 400px !important;
            }
            
            footer .grid {
                grid-template-columns: repeat(3, 1fr) !important;
            }
            
            .container {
                max-width: 960px !important;
                margin: 0 auto !important;
                padding-left: 2rem !important;
                padding-right: 2rem !important;
            }
        }
        
        /* Extra Large Devices (Desktops, 1025px - 1440px) */
        @media (min-width: 1025px) and (max-width: 1440px) {
            .floating-rocket {
                font-size: 7rem !important;
            }
            
            h1.gradient-text {
                font-size: 3.5rem !important;
            }
            
            .glass-card {
                margin: 1.5rem !important;
                padding: 2.5rem !important;
            }
            
            .bento-grid {
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 2rem !important;
            }
            
            .container {
                max-width: 1200px !important;
                margin: 0 auto !important;
                padding-left: 2.5rem !important;
                padding-right: 2.5rem !important;
            }
        }
        
        /* XXL Devices (Large Desktops, 1441px+) */
        @media (min-width: 1441px) {
            .floating-rocket {
                font-size: 8rem !important;
            }
            
            h1.gradient-text {
                font-size: 4rem !important;
            }
            
            .glass-card {
                margin: 2rem !important;
                padding: 3rem !important;
            }
            
            .bento-grid {
                grid-template-columns: repeat(4, 1fr) !important;
                gap: 2.5rem !important;
            }
            
            .container {
                max-width: 1400px !important;
                margin: 0 auto !important;
                padding-left: 3rem !important;
                padding-right: 3rem !important;
            }
        }
        
        /* Landscape Orientation (Mobile) */
        @media (max-width: 768px) and (orientation: landscape) {
            .floating-rocket {
                font-size: 3rem !important;
            }
            
            h1.gradient-text {
                font-size: 2rem !important;
            }
            
            .chat-container {
                max-height: 200px !important;
            }
        }
        
        /* Touch Devices */
        @media (hover: none) and (pointer: coarse) {
            button, .nav-button, a, select {
                min-height: 44px !important;
                min-width: 44px !important;
                padding: 0.75rem 1rem !important;
            }
            
            /* Larger touch targets */
            input[type="file"] {
                min-height: 44px !important;
            }
        }
        
        /* High DPI Displays */
        @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
            .glass-card {
                border-width: 0.5px;
            }
        }
        
        /* Print Styles */
        @media print {
            .glass-card {
                background: white !important;
                border: 1px solid #ccc !important;
                box-shadow: none !important;
            }
            
            nav, footer, button {
                display: none !important;
            }
        }
        
        /* Reduced Motion (Accessibility) */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
        }
        
        /* Dark Mode Support (if needed) */
        @media (prefers-color-scheme: dark) {
            /* Already dark theme, but can add adjustments */
        }
        
        /* ============================================
           END RESPONSIVE MEDIA QUERIES
           ============================================ */


        /* Chat Window Responsive Fixes */
        @media (max-width: 640px) {
            #career-chat-container,
            .chat-container,
            .glass-card:has(.chat-container) {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0.5rem 0 !important;
                padding: 1rem !important;
            }
            
            /* Chat input area */
            #career-chat-container .flex,
            .chat-container .flex {
                flex-direction: column !important;
                gap: 0.75rem !important;
            }
            
            /* Chat buttons */
            #career-chat-container button,
            .chat-container button {
                width: 100% !important;
                margin: 0.25rem 0 !important;
            }
            
            /* Chat message bubble */
            .chat-container .glass-card,
            #career-chat-container .glass-card {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
            }
        }
        
        /* Fix 3: Make cards wider and symmetric on all screen sizes */
        @media (max-width: 480px) {
            .glass-card {
                width: calc(100% - 1rem) !important;
                max-width: 100% !important;
                margin: 0.5rem auto !important;
            }
            
            /* Profile and chat side by side containers */
            .grid.grid-cols-1.md\:grid-cols-2,
            .flex.flex-col.md\:flex-row {
                display: flex !important;
                flex-direction: column !important;
                gap: 1rem !important;
            }
            
            .grid.grid-cols-1.md\:grid-cols-2 > *,
            .flex.flex-col.md\:flex-row > * {
                width: 100% !important;
                max-width: 100% !important;
            }
        }
        
        @media (min-width: 481px) and (max-width: 768px) {
            .glass-card {
                width: calc(100% - 2rem) !important;
                max-width: calc(100% - 2rem) !important;
                margin: 1rem auto !important;
            }
        }
        
        @media (min-width: 769px) {
            .glass-card {
                max-width: 100% !important;
            }
        }
        
        /* Fix 4: Center navbar content properly */
        nav.fixed {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
        }
        
        nav .flex {
            justify-content: center !important;
            align-items: center !important;
            width: 100% !important;
        }
        
        /* Fix 5: Make contact cards wider and symmetric */
        @media (max-width: 640px) {
            /* Contact section cards */
            footer .glass-card,
            #contact .glass-card,
            section:has(h3:contains("Get In Touch")) .glass-card {
                width: calc(100% - 1rem) !important;
                max-width: calc(100% - 1rem) !important;
                margin: 0.5rem auto !important;
            }
            
            /* Contact buttons */
            footer a,
            #contact a,
            section:has(h3:contains("Get In Touch")) a {
                width: 100% !important;
                display: block !important;
                margin: 0.5rem 0 !important;
            }
            
            /* Skills grid */
            footer .grid,
            #contact .grid {
                grid-template-columns: 1fr !important;
                gap: 1rem !important;
            }
        }
        
        /* Fix 6: Ensure all cards are symmetric */
        .glass-card {
            box-sizing: border-box !important;
        }
        
        @media (max-width: 768px) {
            /* All cards should be full width minus padding */
            main .glass-card,
            section .glass-card {
                width: calc(100% - 1rem) !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }
        }


        
        /* ============================================
           SPECIFIC FIXES FOR NAVBAR, CHAT, CARDS
           ============================================ */
        
        /* Fix 1: Center navbar content */
        nav.fixed.top-6 {
            display: flex !important;
            justify-content: center !important;
            align-items: center !important;
        }
        
        nav.fixed .flex {
            justify-content: center !important;
            align-items: center !important;
            width: 100% !important;
            gap: 1rem !important;
        }
        
        /* Fix 2: Chat window responsive for mobile */
        @media (max-width: 640px) {
            /* Chat container full width */
            #career-chat-container,
            .glass-card:has(#career-chat-container),
            .glass-card:has(.chat-container) {
                width: calc(100% - 1rem) !important;
                max-width: calc(100% - 1rem) !important;
                margin: 0.5rem auto !important;
                padding: 1rem !important;
            }
            
            /* Chat input area - stack vertically */
            #career-chat-container .flex.flex-col,
            #career-chat-container .flex:not(.flex-row) {
                flex-direction: column !important;
                gap: 0.75rem !important;
            }
            
            /* Chat buttons full width */
            #career-chat-container button,
            #career-chat-container .flex button {
                width: 100% !important;
                margin: 0.25rem 0 !important;
                display: block !important;
            }
            
            /* Chat message bubble */
            #career-chat-container .glass-card {
                width: 100% !important;
                max-width: 100% !important;
            }
        }
        
        /* Fix 3: Make all cards wider and symmetric on mobile */
        @media (max-width: 640px) {
            /* All glass cards */
            .glass-card {
                width: calc(100% - 1rem) !important;
                max-width: calc(100% - 1rem) !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }
            
            /* Profile and chat containers side by side */
            .grid.grid-cols-1,
            .flex.flex-col {
                display: flex !important;
                flex-direction: column !important;
                gap: 1rem !important;
            }
            
            .grid.grid-cols-1 > *,
            .flex.flex-col > * {
                width: 100% !important;
                max-width: 100% !important;
            }
        }
        
        /* Fix 4: Contact section cards wider and symmetric */
        @media (max-width: 640px) {
            /* Contact section */
            footer .glass-card,
            #contact .glass-card,
            section:has(h3),
            section:has(h2:contains("Get In Touch")) .glass-card {
                width: calc(100% - 1rem) !important;
                max-width: calc(100% - 1rem) !important;
                margin: 0.5rem auto !important;
            }
            
            /* Contact buttons/links */
            footer a,
            #contact a,
            footer .flex a,
            #contact .flex a {
                width: calc(100% - 2rem) !important;
                display: block !important;
                margin: 0.5rem auto !important;
                text-align: center !important;
            }
            
            /* Skills grid - single column */
            footer .grid,
            #contact .grid {
                grid-template-columns: 1fr !important;
                gap: 1rem !important;
                width: 100% !important;
            }
            
            /* Skills grid items */
            footer .grid > *,
            #contact .grid > * {
                width: 100% !important;
            }
        }
        
        /* Fix 5: Ensure symmetric layout for tablet */
        @media (min-width: 641px) and (max-width: 768px) {
            .glass-card {
                width: calc(100% - 2rem) !important;
                max-width: calc(100% - 2rem) !important;
                margin: 1rem auto !important;
            }
        }
        
        /* Fix 6: Profile and Chat sections side by side on mobile */
        @media (max-width: 640px) {
            /* Force single column layout */
            .grid.md\:grid-cols-2,
            .flex.md\:flex-row {
                display: flex !important;
                flex-direction: column !important;
            }
            
            .grid.md\:grid-cols-2 > *,
            .flex.md\:flex-row > * {
                width: 100% !important;
                flex: 1 1 100% !important;
            }
        }

    </style>
    <script>
    // Fix navbar, chat, and cards on page load
    document.addEventListener('DOMContentLoaded', function() {
        // Fix 1: Center navbar
        const nav = document.querySelector('nav');
        if (nav) {
            const flexDiv = nav.querySelector('.flex');
            if (flexDiv) {
                flexDiv.style.justifyContent = 'center';
                flexDiv.style.alignItems = 'center';
                flexDiv.style.width = '100%';
            }
            nav.style.display = 'flex';
            nav.style.justifyContent = 'center';
            nav.style.alignItems = 'center';
        }
        
        // Fix 2: Chat container full width on mobile
        function fixChatContainer() {
            const chatContainer = document.getElementById('career-chat-container') || document.querySelector('.chat-container');
            if (chatContainer && window.innerWidth <= 640) {
                chatContainer.style.width = '100%';
                chatContainer.style.maxWidth = '100%';
                const parent = chatContainer.closest('.glass-card');
                if (parent) {
                    parent.style.width = 'calc(100% - 1rem)';
                    parent.style.maxWidth = 'calc(100% - 1rem)';
                    parent.style.margin = '0.5rem auto';
                }
                
                // Fix chat buttons
                const chatButtons = chatContainer.querySelectorAll('button');
                chatButtons.forEach(btn => {
                    btn.style.width = '100%';
                    btn.style.margin = '0.25rem 0';
                    btn.style.display = 'block';
                });
            }
        }
        
        // Fix 3: Make all cards wider on mobile
        function fixCards() {
            if (window.innerWidth <= 640) {
                document.querySelectorAll('.glass-card').forEach(card => {
                    card.style.width = 'calc(100% - 1rem)';
                    card.style.maxWidth = 'calc(100% - 1rem)';
                    card.style.marginLeft = 'auto';
                    card.style.marginRight = 'auto';
                });
            }
        }
        
        // Run fixes
        fixChatContainer();
        fixCards();
        
        // Re-run on resize
        window.addEventListener('resize', function() {
            fixChatContainer();
            fixCards();
        });
    });
    </script>
